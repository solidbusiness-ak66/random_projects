from datetime import date
from decimal import Decimal

import pytest

from cli_tracker.expense import Expense
from cli_tracker.errors import InvalidExpenseError


def test_create_valid_expense():
    expense = Expense(
        id=1,
        amt=Decimal("150.50"),
        typeof="Food",
        description ="Lunch",
        date="2026-11-07"
    )

    assert expense.id == 1
    assert expense.amt == Decimal("150.50")
    assert expense.typeof == "Food"
    assert expense.description == "Lunch"
    assert expense.date == "2026-11-07"


def test_reject_negative_amt():
    with pytest.raises(InvalidExpenseError):
        Expense(
            id=1,
            amt=Decimal("-100"),
            typeof="Food",
            description="Lunch",
            date="2026-11-07"
        )


